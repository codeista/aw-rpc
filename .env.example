# Environment configuration example for AW-RPC
# Copy this to .env and update with your values

# Flask configuration
FLASK_ENV=development  # Set to 'production' for production
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Server configuration
PORT=5000
HOST=0.0.0.0

# Debug mode (never enable in production!)
DEBUG=False

# Database
DATABASE_URL=sqlite:///aw-rpc.db  # Or PostgreSQL: postgresql://user:pass@host:port/dbname

# CORS configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=aw-rpc.log

# Production server settings
WEB_CONCURRENCY=4  # Number of worker processes
WORKER_CLASS=eventlet  # Required for Socket.IO

# Security settings (production only)
SESSION_COOKIE_SECURE=True  # Only over HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate limiting (requires Redis)
REDIS_URL=redis://localhost:6379/0